# Copy to .env and fill in. The pipeline runs without any key too
# (it then reuses the committed artifacts - see README "offline mode").

# Gemini - powers the memory-only draft pass and the deep-dive extractor.
# Any generateContent model id works; the draft pass is deliberately cheap,
# so a flash-lite model is a reasonable choice (the verified pass 2 does not
# depend on the draft model).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Composio - optional cross-check of which apps already have Composio toolkits.
# Note: keys issued before the v3 API migration are rejected by the current API
# (HTTP 401); the stage degrades gracefully and reports the real error.
COMPOSIO_API_KEY=
